generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Contact Form
model ContactForm {
  id            String       @id @default(cuid())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  firstName     String
  lastName      String
  email         String
  message       String
  agreeToPolicy Boolean
  phone         PhoneNumber? @relation(fields: [phoneId], references: [id])
  phoneId       String?      @unique

  // @@unique([email]) // Changed from @unique on email field to allow multiple forms from same email
}

// Contact PhoneNumber
model PhoneNumber {
  id         String       @id @default(cuid())
  code       String
  phoneCode  String
  number     String
  fullNumber String
  contact    ContactForm?
}

// PSRF Property Sale Request Form Model
model PropertySaleRequest {
  id               String                @id @default(cuid())
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  fullName         String
  email            String
  propertyAddress  String
  propertyType     PropertyType
  other            String? // Optional field for custom property types
  bedrooms         Int
  bathrooms        Int
  squareFootage    Int
  reasonForSelling ReasonForSelling
  timeline         Timeline
  additionalInfo   String?
  agreeToPolicy    Boolean
  phone            SaleRequestFormPhone? @relation(fields: [phoneId], references: [id], onDelete: Cascade)
  phoneId          String                @unique
}

// Booking PhoneNumber
model SaleRequestFormPhone {
  id         String               @id @default(cuid())
  code       String
  phoneCode  String
  number     String
  fullNumber String
  contact    PropertySaleRequest?
}

//Booking form
model BookingForm {
  id            String            @id @default(cuid())
  fullName      String
  email         String
  property      String
  bookingDate   DateTime
  bookingTime   DateTime
  agreeToPolicy Boolean
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  phone         BookingFormPhone? @relation(fields: [phoneId], references: [id], onDelete: Cascade)
  phoneId       String?           @unique
}

// Booking PhoneNumber
model BookingFormPhone {
  id         String       @id @default(cuid())
  code       String
  phoneCode  String
  number     String
  fullNumber String
  contact    BookingForm?
}

// Property Models
model Property {
  id            Int          @id @default(autoincrement())
  title         String
  description   String
  price         Float
  location      String
  bedrooms      Int
  bathrooms     Int
  size          Int
  category      Category
  propertyType  PropertyType @map("property_type")
  parkingSpace  Int          @map("parkingspace")
  petsAllowed   Boolean      @map("petsallowed")
  verified      Boolean
  isNew         Boolean      @map("isnew")
  featured      Boolean      @map("featured") // Fixed capitalization
  hasVideo      Boolean      @map("hasvideo")
  views         Int          @default(0)
  publishedDate DateTime     @map("publisheddate")
  createdAt     DateTime     @default(now())

  // Relations
  images      PropertyImage[]
  amenities   Amenity[]
  notIncluded NotIncludedItem[]
  visitors    Visitor[]

  // Single admin user relation
  adminUser   User   @relation("AdminProperties", fields: [adminUserId], references: [id])
  adminUserId String

  @@map("properties")
}

model PropertyImage {
  id         Int      @id @default(autoincrement())
  url        String
  alt        String
  isMain     Boolean  @default(false)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId Int

  @@map("property_images")
}

model Amenity {
  id         Int      @id @default(autoincrement())
  name       String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId Int

  @@map("amenities")
}

model NotIncludedItem {
  id         Int      @id @default(autoincrement())
  name       String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId Int

  @@map("not_included_items")
}

model Visitor {
  id         String   @id @default(cuid())
  email      String
  favorite   Boolean  @default(false)
  createdAt  DateTime @default(now())
  upDatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId Int

  @@map("visitors")
}

// Single admin user model
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  image         String?
  name          String
  passwordHash  String? // Added for admin authentication
  role          UserRole   @default(ADMIN) // Added role field
  accounts      Account[]
  properties    Property[] @relation("AdminProperties")
  sessions      Session[]

  // 2FA
  twoFactorCode    String?
  twoFactorExpires DateTime?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

enum Category {
  RENT
  SALE
}

enum ReasonForSelling {
  INVESTMENT_SALE
  UPGRADING
  RELOCATION
  DOWNSIZING
  OTHER
}

enum Timeline {
  ASAP
  ONE_TO_THREE_MONTHS @map("1-3 months")
  THREE_TO_SIX_MONTHS @map("3-6 months")
  FLEXIBLE
}

enum PropertyType {
  APARTMENT
  BUNGALOW
  MAISONETTE
  STUDIO_APARTMENT
  SERVICED_APARTMENT
  PENTHOUSE
  TOWNHOUSE
  VILLA
  MANSION
  DUPLEX
  SINGLE_FAMILY_HOME
  MULTI_FAMILY_HOME
  OTHER
}

// Added user role enum
enum UserRole {
  ADMIN
}
